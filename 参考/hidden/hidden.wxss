@import "/styles/common.wxss";
@import '/styles/glassmorphism.wxss';

.container {
  min-height: 100vh;
  background-color: rgba(245, 247, 250, 0.8);
  position: relative;
  overflow: hidden;
  padding: 30rpx 20rpx;
}

/* 背景装饰 */
.background {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  z-index: 0;
  opacity: 0.6;
}

.bg-circle {
  position: absolute;
  border-radius: 50%;
  opacity: 0.06;
  filter: blur(20rpx);
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  background: linear-gradient(135deg, #4CAF50, #8BC34A);
  top: -100rpx;
  right: -100rpx;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  background: linear-gradient(135deg, #2196F3, #03A9F4);
  bottom: -50rpx;
  left: -50rpx;
}

.circle-3 {
  width: 200rpx;
  height: 200rpx;
  background: linear-gradient(135deg, #FF9800, #FFC107);
  top: 40%;
  right: 5%;
}

/* 主要内容区域 */
.main-content {
  position: relative;
  z-index: 1;
  max-width: 1000rpx;
  margin: 0 auto;
}

/* 标题区域 */
.header {
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  padding: 30rpx;
  background: rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  backdrop-filter: blur(10rpx);
}

.app-icon {
  width: 100rpx;
  height: 100rpx;
  margin-right: 30rpx;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.08);
}

.title-container {
  flex: 1;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

.main-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #333;
  display: inline-block;
  letter-spacing: 2rpx;
  line-height: 1.4;
  margin-right: 20rpx;
}

.sub-title {
  font-size: 26rpx;
  color: #666;
  display: inline-block;
  line-height: 1.6;
  letter-spacing: 1rpx;
  opacity: 0.9;
}



/* 相关链接区域 - 整合到使用说明卡片中 */
.links-section {
  margin-top: 30rpx;
  padding-top: 20rpx;
  border-top: 2rpx solid #ecf0f1;
}

/* 公众号关注提示卡片 */
.follow-tip-card {
  background: linear-gradient(135deg, #f8f9fa, #e9ecef);
  border-radius: 16rpx;
  padding: 25rpx;
  margin: 30rpx 30rpx 20rpx;
  text-align: center;
  border-left: 4rpx solid #4CAF50;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
  position: relative;
  z-index: 1;
}

.tip-text {
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
  line-height: 1.4;
}

.link-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  position: relative;
  transition: all 0.3s ease;
  border-radius: 12rpx;
  margin-bottom: 10rpx;
}

.link-item:active {
  background-color: rgba(76, 175, 80, 0.05);
  transform: scale(0.98);
}

.link-icon {
  width: 40rpx;
  height: 40rpx;
  margin-right: 20rpx;
}

.link-text {
  flex: 1;
  font-size: 28rpx;
  color: #666666;
  font-weight: 500;
}

.link-arrow {
  font-size: 28rpx;
  color: #cccccc;
  margin-right: 10rpx;
  transition: all 0.3s ease;
}

.link-item:active .link-arrow {
  color: #4CAF50;
  transform: translateX(5rpx);
}

/* 表单卡片 */
.form-card {
  background: rgba(255, 255, 255, 0.7);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  border: 1rpx solid rgba(0, 0, 0, 0.03);
  backdrop-filter: blur(10rpx);
}

.form-section {
  margin-bottom: 30rpx;
  position: relative;
}

.form-section:last-child {
  margin-bottom: 0;
}

.section-title {
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-text {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
  position: relative;
  padding-left: 20rpx;
}

.section-text::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 4rpx;
  height: 20rpx;
  background: #4CAF50;
  border-radius: 2rpx;
}

/* 单选框样式 */
.radio-group {
  display: flex;
  justify-content: center;
  background: #f8f9fa;
  padding: 10rpx;
  border-radius: 16rpx;
  margin-top: 10rpx;
}

.radio-item {
  flex: 0 1 auto;
  text-align: center;
  padding: 16rpx 30rpx;
  border-radius: 12rpx;
  transition: all 0.3s;
  margin: 0 10rpx;
}

.radio-item.active {
  background: #fff;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.05);
}

.radio-item text {
  font-size: 26rpx;
  color: #666;
  display: block;
  margin-top: 6rpx;
}

.radio-item.active text {
  color: #4CAF50;
  font-weight: 500;
}

/* 输入框样式 */
.form-input {
  width: 100%;
  max-width: 100%;
  box-sizing: border-box;
  height: 80rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #333;
  margin-top: 10rpx;
  transition: all 0.3s;
  border: 1rpx solid transparent;
}

.form-input:focus {
  background: #fff;
  border-color: #4CAF50;
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.1);
}

.form-input::placeholder {
  color: #999;
  font-size: 24rpx;
}

/* 步数滑块样式 */
.steps-slider-container {
  margin-top: 24rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 24rpx 20rpx;
}

.steps-slider {
  margin: 20rpx 0;
}

.slider-values {
  display: flex;
  justify-content: space-between;
  font-size: 22rpx;
  color: #999;
  padding: 0 16rpx;
  margin-top: 12rpx;
}

.current-value {
  color: #4CAF50;
  font-weight: 500;
  font-size: 26rpx;
  background: rgba(76, 175, 80, 0.1);
  padding: 4rpx 16rpx;
  border-radius: 16rpx;
}

/* 提交按钮样式 */
.submit-btn {
  width: 100%;
  height: 80rpx;
  background: #4CAF50;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 50rpx;
  box-shadow: 0 4rpx 16rpx rgba(76, 175, 80, 0.2);
  transition: all 0.3s;
}

.submit-btn:active {
  transform: scale(0.98);
  box-shadow: 0 2rpx 8rpx rgba(76, 175, 80, 0.15);
}

.submit-btn.loading {
  opacity: 0.8;
}

.loading-container {
  display: flex;
  align-items: center;
}

.loading-spinner {
  width: 28rpx;
  height: 28rpx;
  border: 3rpx solid rgba(255, 255, 255, 0.3);
  border-top-color: #fff;
  border-radius: 50%;
  margin-right: 10rpx;
  animation: spin 1s linear infinite;
}

@keyframes spin {
  to {
    transform: rotate(360deg);
  }
}

/* 使用说明卡片 */
.tips-card {
  background: rgba(255, 255, 255, 0.7);
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.03);
  backdrop-filter: blur(10rpx);
}

.tips-header {
  display: flex;
  align-items: center;
  margin-bottom: 24rpx;
}

.tips-title {
  font-size: 28rpx;
  color: #333;
  font-weight: 500;
}

.tips-content {
  padding: 12rpx 0;
}



.tip-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
  padding: 16rpx;
  background: #f5f7fa;
  border-radius: 16rpx;
  transition: all 0.3s;
}

.tip-item:last-child {
  margin-bottom: 0;
}

.tip-number {
  width: 40rpx;
  height: 40rpx;
  background: #4CAF50;
  color: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  margin-right: 20rpx;
  flex-shrink: 0;
  font-weight: 500;
}

.tip-text {
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
  flex: 1;
}

.tip-item.warning {
  margin-top: 24rpx;
  padding: 20rpx;
  background: #FFF3E0;
  border: 2rpx solid #FFE0B2;
  display: flex;
  align-items: center;
}

.tip-item.warning .tip-icon {
  font-size: 32rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.tip-item.warning .tip-text {
  color: #FF9800;
  font-weight: 500;
  text-align: left;
  padding-left: 0;
}

/* 弹窗样式 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
  backdrop-filter: blur(4rpx);
}

.modal-content {
  width: 88%;
  max-width: 620rpx;
  background: rgba(255, 255, 255, 0.8);
  border-radius: 24rpx;
  overflow: hidden;
  animation: modalShow 0.3s ease-out;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.08);
  backdrop-filter: blur(10rpx);
}

@keyframes modalShow {
  from {
    transform: scale(0.9);
    opacity: 0;
  }
  to {
    transform: scale(1);
    opacity: 1;
  }
}

.modal-header {
  padding: 30rpx;
  text-align: center;
  border-bottom: 2rpx solid #f5f7fa;
}

.modal-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #333;
}

.modal-body {
  padding: 40rpx 36rpx;
  text-align: left;
  display: flex;
  flex-direction: column;
  align-items: stretch;
}

.modal-icon {
  margin-bottom: 24rpx;
  font-size: 80rpx;
  display: block;
  text-align: center;
}

.modal-message {
  font-size: 28rpx;
  color: #666;
  line-height: 1.6;
  width: 100%;
  text-align: left;
  word-break: break-all;
  white-space: normal;
}

.modal-footer {
  padding: 20rpx 30rpx;
  border-top: 2rpx solid #f5f7fa;
}

.modal-btn {
  width: 100%;
  height: 80rpx;
  background: #4CAF50;
  color: #fff;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s;
}

.modal-btn:active {
  transform: scale(0.98);
  opacity: 0.9;
}
