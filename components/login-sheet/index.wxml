<view wx:if="{{show}}">
  <view class="mask" bindtap="onMask"></view>
  <view class="sheet {{visible ? 'sheet--show' : ''}}" catchtouchmove="noop">
    <view class="drag"></view>
    <view class="sheet-head">
      <view class="head-copy">
        <view class="title">{{profileStep ? '授权信息' : '授权登录'}}</view>
        <view class="subtitle">{{profileStep ? '完善头像和昵称后继续使用' : '登录后可继续使用完整服务'}}</view>
      </view>
      <view class="close" bindtap="onMask">×</view>
    </view>

    <block wx:if="{{!profileStep}}">
      <button class="wechat-button" bindtap="onWechatLoginTap" loading="{{submitting}}">
        <text>一键登录</text>
      </button>

      <view class="row row-agree">
        <label class="agree">
          <view class="radio {{agreed ? 'checked' : ''}}" bindtap="toggleAgree"></view>
          <text class="agree-text" bindtap="toggleAgree">我已阅读并遵守</text>
          <text class="link" bindtap="openUserAgreement">《用户协议》</text>
          <text class="agree-text">与</text>
          <text class="link" bindtap="openPrivacy">《隐私协议》</text>
        </label>
      </view>
    </block>

    <block wx:else>
      <view class="profile-form">
        <view class="profile-row">
          <text class="profile-label">头像</text>
          <button class="avatar-button" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
            <image class="avatar-image" mode="aspectFill" src="{{avatarUrl}}" />
          </button>
        </view>
        <view class="profile-row">
          <text class="profile-label">昵称</text>
          <input
            class="nickname-input"
            type="nickname"
            placeholder="请输入昵称"
            value="{{nickname}}"
            bindinput="onNicknameInput"
          />
        </view>
      </view>

      <button class="profile-button" bindtap="onConfirmProfile" loading="{{submitting}}">
        确认授权
      </button>
    </block>
    <view class="error" wx:if="{{errMsg}}">{{errMsg}}</view>
    <view class="safe-bottom"></view>
  </view>
</view>
