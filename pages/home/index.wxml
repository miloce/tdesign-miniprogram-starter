<nav title-text="网红代码生成" />

<view class="home-container">
  <view class="search-panel">
    <t-icon name="search" size="36rpx" color="#0792ff" />
    <input
      value="{{keyword}}"
      placeholder="搜索表白、生日、祝福代码"
      confirm-type="search"
      bindinput="onSearchInput"
      bindconfirm="onSearchConfirm"
    />
  </view>

  <view class="template-layout">
    <scroll-view class="side-menu" scroll-y enhanced show-scrollbar="{{false}}" style="height: 100%;">
      <view
        wx:for="{{categories}}"
        wx:key="*this"
        class="side-menu__item {{activeCategory === item ? 'side-menu__item--active' : ''}}"
        data-category="{{item}}"
        bindtap="onCategoryChange"
      >
        {{item}}
      </view>
      <view class="home-bottom-spacer" />
    </scroll-view>

    <scroll-view
      class="template-main"
      scroll-y
      enhanced
      show-scrollbar="{{false}}"
      scroll-top="{{mainScrollTop}}"
      lower-threshold="160"
      bindscrolltolower="onReachBottom"
      refresher-enabled="{{true}}"
      refresher-triggered="{{enable}}"
      bindrefresherrefresh="onRefresh"
      style="height: 100%;"
    >
      <view wx:if="{{loadingInitial}}" class="template-grid">
        <view wx:for="{{[1,2,3,4,5,6]}}" wx:key="*this" class="template-card template-card--skeleton">
          <view class="template-card__cover skeleton-block"></view>
          <view class="template-card__title skeleton-line"></view>
        </view>
      </view>
      <view wx:else class="template-grid">
        <view
          wx:for="{{filteredTemplates}}"
          wx:key="id"
          class="template-card"
          data-id="{{item.id}}"
          bindtap="onTemplateTap"
        >
          <view class="template-card__cover">
            <image src="{{item.cover}}" mode="aspectFit" lazy-load="{{true}}" />
          </view>
          <view class="template-card__title">{{item.title}}</view>
        </view>
      </view>
      <t-empty wx:if="{{!loadingInitial && filteredTemplates.length === 0}}" description="没有找到相关模板" />
      <view wx:if="{{loadingMore}}" class="load-text">正在加载更多</view>
      <view wx:if="{{noMore && filteredTemplates.length > 0}}" class="load-text">没有更多了~</view>
      <view class="home-bottom-spacer" />
    </scroll-view>
  </view>
</view>

<t-message id="t-message" />
